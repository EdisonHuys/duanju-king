<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.duanju.mapper.DjScriptMapper">

    <resultMap type="com.ruoyi.duanju.domain.DjScript" id="DjScriptResult">
        <id     property="id"                 column="id"                 />
        <result property="scriptId"           column="script_id"          />
        <result property="title"              column="title"              />
        <result property="subtitle"           column="subtitle"           />
        <result property="tag"                column="tag"                />
        <result property="recommend"          column="recommend"          />
        <result property="difficulty"         column="difficulty"         />
        <result property="totalEpisodes"      column="total_episodes"     />
        <result property="endingCount"        column="ending_count"       />
        <result property="coverTheme"         column="cover_theme"        />
        <result property="coverImage"         column="cover_image"        />
        <result property="defaultProtagonist" column="default_protagonist"/>
        <result property="synopsis"           column="synopsis"           />
        <result property="initialStatsJson"   column="initial_stats_json" />
        <result property="episodesJson"       column="episodes_json"      />
        <result property="endingsJson"        column="endings_json"       />
        <result property="version"            column="version"            />
        <result property="sortOrder"          column="sort_order"         />
        <result property="status"             column="status"             />
        <result property="playCount"          column="play_count"         />
        <result property="finishCount"        column="finish_count"       />
        <result property="delFlag"            column="del_flag"           />
        <result property="createBy"           column="create_by"          />
        <result property="createTime"         column="create_time"        />
        <result property="updateBy"           column="update_by"          />
        <result property="updateTime"         column="update_time"        />
        <result property="remark"             column="remark"             />
    </resultMap>

    <!-- 严禁 SELECT *，显式列出所有列 -->
    <sql id="selectDjScriptVo">
        select id, script_id, title, subtitle, tag, recommend, difficulty, 
               total_episodes, ending_count, cover_theme, cover_image, default_protagonist, 
               synopsis, initial_stats_json, episodes_json, endings_json, version, 
               sort_order, status, play_count, finish_count, del_flag, create_by, 
               create_time, update_by, update_time, remark
        from dj_script
    </sql>

    <!-- 列表查询：必须带 del_flag = '0' 过滤 -->
    <select id="selectDjScriptList" parameterType="com.ruoyi.duanju.domain.DjScript" resultMap="DjScriptResult">
        <include refid="selectDjScriptVo"/>
        <where>
            del_flag = '0'
            <if test="title != null and title != ''">
                and title like concat('%', #{title}, '%')
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
            <if test="tag != null and tag != ''">
                and tag = #{tag}
            </if>
        </where>
        order by sort_order asc, id asc
    </select>

    <select id="selectDjScriptById" parameterType="Long" resultMap="DjScriptResult">
        <include refid="selectDjScriptVo"/>
        where id = #{id} and del_flag = '0'
    </select>

    <select id="selectDjScriptByScriptId" parameterType="String" resultMap="DjScriptResult">
        <include refid="selectDjScriptVo"/>
        where script_id = #{scriptId} and del_flag = '0'
    </select>

    <insert id="insertDjScript" parameterType="com.ruoyi.duanju.domain.DjScript" useGeneratedKeys="true" keyProperty="id">
        insert into dj_script(
            script_id, title, subtitle, tag, recommend, difficulty, 
            total_episodes, ending_count, cover_theme, cover_image, default_protagonist, 
            synopsis, initial_stats_json, episodes_json, endings_json, version, 
            sort_order, status, del_flag, create_by, create_time
        ) values (
            #{scriptId}, #{title}, #{subtitle}, #{tag}, #{recommend}, #{difficulty},
            #{totalEpisodes}, #{endingCount}, #{coverTheme}, #{coverImage}, #{defaultProtagonist},
            #{synopsis}, #{initialStatsJson}, #{episodesJson}, #{endingsJson}, #{version},
            #{sortOrder}, #{status}, '0', #{createBy}, sysdate()
        )
    </insert>

    <update id="updateDjScript" parameterType="com.ruoyi.duanju.domain.DjScript">
        update dj_script
        <set>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="subtitle != null">subtitle = #{subtitle},</if>
            <if test="tag != null">tag = #{tag},</if>
            <if test="recommend != null">recommend = #{recommend},</if>
            <if test="difficulty != null">difficulty = #{difficulty},</if>
            <if test="totalEpisodes != null">total_episodes = #{totalEpisodes},</if>
            <if test="endingCount != null">ending_count = #{endingCount},</if>
            <if test="coverTheme != null">cover_theme = #{coverTheme},</if>
            <if test="coverImage != null">cover_image = #{coverImage},</if>
            <if test="defaultProtagonist != null">default_protagonist = #{defaultProtagonist},</if>
            <if test="synopsis != null">synopsis = #{synopsis},</if>
            <if test="initialStatsJson != null">initial_stats_json = #{initialStatsJson},</if>
            <if test="episodesJson != null">episodes_json = #{episodesJson},</if>
            <if test="endingsJson != null">endings_json = #{endingsJson},</if>
            <if test="version != null">version = #{version},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id} and del_flag = '0'
    </update>

    <!-- 逻辑删除：严禁物理删除 -->
    <update id="deleteDjScriptById" parameterType="Long">
        update dj_script set del_flag = '2', update_time = sysdate() where id = #{id}
    </update>

    <update id="incrementPlayCount">
        update dj_script 
        set play_count = play_count + 1
        <if test="finished">
            , finish_count = finish_count + 1
        </if>
        where script_id = #{scriptId} and del_flag = '0'
    </update>

</mapper>
